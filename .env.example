# Kalshi API credentials
# Generate at: https://kalshi.com/account/profile → API Keys
KALSHI_API_KEY_ID=your-api-key-uuid-here
KALSHI_PRIVATE_KEY_PATH=./kalshi.key

# Environment: "demo" or "prod"
KALSHI_ENV=demo

# Trading limits
MAX_ORDER_CENTS=2500          # max cost per arb pair in cents ($25.00)
MAX_CONTRACTS=100             # max contracts per leg
MAX_OPEN_POSITIONS=20         # max simultaneous arb positions

# Arb thresholds
MIN_PROFIT_CENTS=5            # minimum locked profit per pair to fire (after fees)
MIN_VOLUME_24H=50             # minimum 24h volume on both sides

# Scanning
SCAN_INTERVAL_SECONDS=15      # how often to scan for arb opportunities
SCAN_CATEGORIES=all           # comma-separated: economics,politics,crypto,sports,all

# Execution
DRY_RUN=true                  # true = log only, false = place real orders
LOG_LEVEL=INFO
LOG_FILE=kalshi_arb.log
